<!DOCTYPE html>
<html lang="en">
{% set seo=showcaseContent.seo|default({}) %}
{% if not title %}
    {% set title=seo.title|default(siteConfig.title_for_layout) %}
{% endif %}
{% if not description %}
    {% set description=seo.description|default(siteConfig.site_desc_long) %}
{% endif %}
{% if not keywords %}
    {% set keywords=seo.keywords|default(siteConfig.tags) %}
{% endif %}
<head itemscope itemtype="http://schema.org/WebSite">
    {% block head %}
        <title>{{ title }}</title>
        <meta charset="utf-8"/>
        <link href="/{{ get_favicon_name() }}{{ asset_version(get_favicon_name()) }}" type="image/x-icon" rel="icon"/>
        <link href="/{{ get_favicon_name() }}{{ asset_version(get_favicon_name()) }}" type="image/x-icon" rel="shortcut icon"/>
        <meta name="copyright" content="{{ seo.copyright|default(siteConfig.company_name|default(siteConfig.title_for_layout)) }}"/>
        <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
        <meta name="description" content="{{ description }}">
        <meta name="keywords" content="{{ keywords }}">
        <meta name="Security" content="Public">
        <meta name="Abstract" content="{{ seo.abstract|default(description) }}">
        <meta name="Author" content="{{ seo.author|default(siteConfig.company_name|default(siteConfig.title_for_layout)) }}">
        <meta name="Robots" content="{{ seo.robots|default('index,follow') }}">
        <meta name="generator" content="{{ seo.generator|default('Camoo Hosting') }}"/>
        {% include 'Layouts/Blocks/Layouts/css.twig' %}
    {% endblock %}
</head>
<body>
<div id="header">
    {% include 'Layouts/Blocks/Layouts/header.twig' %}
</div>
<div id="rs-slider">{% include 'Layouts/Blocks/Layouts/slider.twig' %}</div>
<div id="content">{% block content %}{% endblock %}</div>
<div id="rs-footer">{% include 'Layouts/Blocks/Layouts/footer.twig' %}</div>
{% include 'Layouts/Blocks/Layouts/js.twig' %}
</body>
</html>
