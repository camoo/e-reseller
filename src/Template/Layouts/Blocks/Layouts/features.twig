{% block features %}
    {% set featureContent = homeContent.features|default({}) %}
    {% set featureTabs = featureContent.tabs|default([]) %}
    {% if featureTabs|length > 0 %}
    <div class="core_features">
        <div class="container">
            <div class="border-bottm">
                <div class="row">
                    <div class="col-xl-6 col-md-6">
                        <div class="featuures_heading">
                            <h3>{{ t(featureContent.title|default('Caractéristiques de base')) }}</h3>
                        </div>
                    </div>
                    <div class="col-xl-6 col-md-6">
                        <div class="featurest_tabs">
                            <nav>
                                <div class="nav" id="nav-tab" role="tablist">
                                    {% for tab in featureTabs %}
                                        {% set tabId = 'nav-feature-tab-' ~ loop.index %}
                                        <a class="nav-item nav-link{% if loop.first %} active{% endif %}" id="{{ tabId }}"
                                            data-toggle="tab" href="#nav-feature-{{ loop.index }}" role="tab"
                                            aria-controls="nav-feature-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">
                                            {{ t(tab.label|default('Fonctionnalités')) }}
                                        </a>
                                    {% endfor %}
                                </div>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xl-12">
                    <div class="tab-content" id="nav-feature-content">
                        {% for tab in featureTabs %}
                            <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="nav-feature-{{ loop.index }}"
                                role="tabpanel" aria-labelledby="nav-feature-tab-{{ loop.index }}">
                                <div class="row">
                                    {% for item in tab.items|default([]) %}
                                        <div class="col-xl-6">
                                            <div class="single_features">
                                                <div class="icon {{ item.class|default('') }}"><i class="{{ item.icon|default('flaticon-browser') }}"></i></div>
                                                <div class="features_info">
                                                    <h4>{{ t(item.title|default('')) }}</h4>
                                                    <p>{{ t(item.description|default('')) }}</p>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Integration Options (ConnectReseller Style) -->
    <div class="cr-integration-section">
        <div class="container">
            <div class="cr-section-header text-center">
                <span class="cr-section-badge">{{ t('Écosystème & Outils') }}</span>
                <h2 class="cr-section-title">{{ t('Options d\'Intégration & Gestion') }}</h2>
                <p class="cr-section-desc">{{ t('Profitez d\'outils modernes pour automatiser, piloter et intégrer vos noms de domaine en toute simplicité.') }}</p>
            </div>
            <div class="row cr-integration-grid justify-content-center">
                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="cr-integration-card">
                        <div class="cr-integration-icon-wrap cr-icon-panel">
                            <i class="flaticon-browser"></i>
                        </div>
                        <h4 class="cr-integration-title">{{ t('Panneau de Contrôle') }}</h4>
                        <p class="cr-integration-text">{{ t('Une interface fluide et intuitive pour gérer vos DNS, renouvellements, redirections et certificats en toute autonomie.') }}</p>
                        <div class="cr-integration-tag">{{ t('Inclus à vie') }}</div>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="cr-integration-card">
                        <div class="cr-integration-icon-wrap cr-icon-api">
                            <i class="flaticon-security"></i>
                        </div>
                        <h4 class="cr-integration-title">{{ t('API REST Développeurs') }}</h4>
                        <p class="cr-integration-text">{{ t('Intégrez l\'achat, la vérification de disponibilité et la gestion de vos domaines directement au sein de vos applications.') }}</p>
                        <div class="cr-integration-tag">{{ t('Haute Performance') }}</div>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="cr-integration-card">
                        <div class="cr-integration-icon-wrap cr-icon-billing">
                            <i class="flaticon-like"></i>
                        </div>
                        <h4 class="cr-integration-title">{{ t('Automatisation & Alertes') }}</h4>
                        <p class="cr-integration-text">{{ t('Notifications automatiques de renouvellement, synchronisation en temps réel et protection contre l\'expiration.') }}</p>
                        <div class="cr-integration-tag">{{ t('Sérénité Garantie') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
