{% block slider %}
    <!-- slider_area_start -->
    {% if feature_enabled('domains') %}
    <div class="slider_area">
        <div class="single_slider d-flex align-items-center justify-content-center slider_bg_1 overlay2">
            <div class="container">
                {{ 'flash'|show_flash }}
                <div class="row align-items-center justify-content-center">
                    <div class="col-xl-9">
                        <div class="slider_text text-center">
                            <p>{{ t('Nous sommes le meilleur fournisseur de nom de domaine et Hébergeur Web au Cameroun') }}</p>
                            <h3>{{ t('Trouvez votre domaine') }}</h3>
                            <div class="find_dowmain">
                                {{ form_start('domain-lookup', {'id':'domainwhois', 'class': 'find_dowmain_form'}) }}
                                {{ form_input('domain', {'placeholder' : t('Rechercher votre nom de domaine'), 'required' : 'required'}) }}
                                {{ form_input('submit', {'type' : 'submit', 'value' : t('Lancer'), 'id' : 'finddomain'}) }}
                                {{ form_end() }}
                            </div>
                            <div class="domain_tld_pills d-flex justify-content-center flex-wrap align-items-center">
                                <div class="tld_pill"><strong class="tld_name">.com</strong> <span class="tld_price">XAF 7,500</span></div>
                                <div class="tld_pill"><strong class="tld_name">.net</strong> <span class="tld_price">XAF 8,500</span></div>
                                <div class="tld_pill"><strong class="tld_name">.org</strong> <span class="tld_price">XAF 9,000</span></div>
                                <div class="tld_pill tld_pill_popular"><strong class="tld_name">.cm</strong> <span class="tld_price">XAF 6,500</span> <span class="tld_tag">{{ t('Populaire') }}</span></div>
                                <div class="tld_pill tld_pill_email"><strong class="tld_name">.email</strong> <span class="tld_price">XAF 5,000</span> <span class="tld_tag">{{ t('Email Included') }}</span></div>
                                <div class="tld_pill tld_pill_ssl"><strong class="tld_name">SSL</strong> <span class="tld_price">{{ t('Gratuit') }}</span> <span class="tld_tag">{{ t('Secured') }}</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    <!-- slider_area_end -->
{% endblock %}
