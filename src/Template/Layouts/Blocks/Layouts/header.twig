{% block header %}
    {% set navigation=showcaseContent.navigation|default({}) %}
    {% set currentProduct=product_type|default('') %}
    <!-- header-start -->
    <header>
        <div class="header-area ">
            <div id="sticky-header" class="main-header-area">
                <div class="container-fluid p-0">
                    <div class="row align-items-center no-gutters">
                        <div class="col-xl-2 col-lg-2 header-brand">
                            <div class="logo-img">
                                <a href="/">
                                    <img src="/img/{{ get_logo_name() }}{{ asset_version('img/' ~ get_logo_name()) }}" alt="{{ siteConfig.company_name }}">
                                </a>
                            </div>
                        </div>
                        <div class="col-xl-7 col-lg-7 header-navigation">
                            <div class="main-menu  d-none d-lg-block">
                                <nav>
                                    <ul id="navigation">
                                        <li><a class="{{ pages_active }}" href="/">{{ t(navigation.home|default('Accueil')) }}</a></li>
                                        {% if feature_enabled('domains') %}
                                            <li><a href="/#domainwhois">{{ t(navigation.domains|default('Domaines')) }}</a></li>
                                        {% endif %}
                                        {% if feature_enabled('hosting') %}
                                            <li><a class="{% if currentProduct == '' %}{{ packages_active }}{% endif %}" href="/packages">{{ t(navigation.hosting|default('Package')) }}{% if feature_enabled('servers') %} <i class="ti-angle-down"></i>{% endif %}</a>
                                                {% if feature_enabled('servers') %}
                                                    <ul class="submenu">
                                                        <li><a class="{% if currentProduct == 'vps' %}{{ packages_active }}{% endif %}" href="/packages/vps">{{ t(navigation.vps|default('VPS')) }}</a></li>
                                                    </ul>
                                                {% endif %}
                                            </li>
                                        {% elseif feature_enabled('servers') %}
                                            <li><a class="{% if currentProduct == 'vps' %}{{ packages_active }}{% endif %}" href="/packages/vps">{{ t(navigation.vps|default('VPS')) }}</a></li>
                                        {% endif %}
                                        {% if feature_enabled('emails') %}
                                            <li><a class="{% if currentProduct == 'emails' %}{{ packages_active }}{% endif %}" href="/packages/email">{{ t(navigation.emails|default('Emails')) }}</a></li>
                                        {% endif %}
                                        {% if feature_enabled('ssl') %}
                                            <li><a class="{% if currentProduct == 'ssl' %}{{ packages_active }}{% endif %}" href="/packages/ssl">{{ t(navigation.ssl|default('SSL')) }}</a></li>
                                        {% endif %}

                                        <!-- li><a href="#">pages <i class="ti-angle-down"></i></a>
                                            <ul class="submenu">
                                                <li><a href="elements.html">elements</a></li>
                                            </ul>
                                        </li -->
                                        <!--li><a class="{{ support_active }}" href="/support">Support</a></li -->

                                        <li><a class="{{ contact_active }}" href="/contact">{{ t(navigation.contact|default('Contact')) }}</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 d-none d-lg-block header-actions">
                            <div class="log_chat_area d-flex align-items-center">
                                {% if feature_enabled('domains') or feature_enabled('hosting') %}
                                <div id="line-cart"
                                    class="header-cart rs-pointer{% if basket_counter() < 1 %} invisible{% endif %}">
                                    <button type="button" class="header-cart-trigger" aria-label="{{ t(navigation.cart_title|default('Votre Panier')) }}">
                                        <span class="icon-cart" aria-hidden="true">
                                            <span class="cart-line-1"></span>
                                            <span class="cart-line-2"></span>
                                            <span class="cart-line-3"></span>
                                            <span class="cart-wheel"></span>
                                        </span>
                                        <span class="cart-label">{{ t(navigation.cart|default('Panier')) }}</span>
                                        <span id="cart-count" class="w3-badge w3-red">{{ basket_counter() }}</span>
                                    </button>
                                    <ul class="submenu ul-basket">
                                        <li class="title">{{ t(navigation.cart_title|default('Votre Panier')) }}</li>
                                        {% for key,item in basket_items() %}
                                            {% if key == "hosting" %}
                                                {% for idex,hash in item %}
                                                    <li class="cart-item" id="{{ hash.id }}" data-cart-sku="{{ hash.sku }}">
                                                        <div class="cart-item-description">
                                                            <span title="{{ hash.name }}" class="cart-key"><strong>{{ hash.human_name }}</strong></span>
                                                            <span class="cart-price"> XAF {{ hash.price }}</span>
                                                            <span title="Supprimer" data-id="{{ hash.id }}" data-type="hosting" data-sku="{{ hash.sku }}" class="delete-btn delete-cart-item"></span>
                                                        </div>
                                                    </li>
                                                {% endfor %}
                                            {% else %}
                                                <li class="cart-item" data-cart-sku="{{ key }}">
                                                    <div class="cart-item-description">
                                                        <span title="{{ key }}" class="cart-key"><strong>{{ key }}</strong></span>
                                                        <span class="cart-price"> XAF {{ item.price }}</span>
                                                        <span title="Supprimer" data-sku="{{ key }}" class="delete-btn delete-cart-item"></span>
                                                    </div>
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                        <li class="kasse">
                                            <a class="boxed_btn_green" href="/basket" id="camoo-kasse"><span>{{ t(navigation.checkout|default('à la caisse')) }}</span></a>
                                        </li>
                                    </ul>

                                </div>
                                {% endif %}
                                {% if is_loggedin() %}
                                    {{ form_start('logout', {'url': '/logout', 'class': 'd-inline'}) }}
                                    <button type="submit" id="camoo-logout" class="login border-0 bg-transparent">
                                        <i class="flaticon-lock"></i>
                                        <span id="logout">{{ t(navigation.logout|default('Déconnexion')) }}</span>
                                    </button>
                                    {{ form_end() }}
                                    <div class="live_chat_btn">
                                        <a class="boxed_btn_green goto-cpanel" href="#" id="camoo-dashbord">
                                            <i class="flaticon-browser"></i>
                                            <span>cPanel</span>
                                        </a>
                                    </div>
                                {% else %}
                                    <a href="/login" id="camoo-login" class="login">
                                        <i class="flaticon-user"></i>
                                        <span id="login">{{ t(navigation.login|default('Connexion')) }}</span>
                                    </a>
                                    <a href="/register" id="camoo-register" class="header-register-cta">
                                        {{ t(navigation.register|default('Créer un compte')) }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="mobile_menu d-block d-lg-none"></div>
                            <div class="mobile-header-actions d-flex d-lg-none">
                                {% if is_loggedin() %}
                                    {{ form_start('logout-mobile', {'url': '/logout'}) }}
                                    <button type="submit" class="login border-0 bg-transparent">{{ t(navigation.logout|default('Déconnexion')) }}</button>
                                    {{ form_end() }}
                                {% else %}
                                    <a href="/login" id="camoo-login-mobile" class="login">
                                        <i class="flaticon-user"></i>
                                        <span>{{ t(navigation.login|default('Connexion')) }}</span>
                                    </a>
                                    <a href="/register" id="camoo-register-mobile" class="header-register-cta">
                                        {{ t(navigation.register|default('Créer un compte')) }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- header-end -->
{% endblock %}
