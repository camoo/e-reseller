{% block css %}
    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <link rel="stylesheet" href="/css/owl.carousel.min.css{{ asset_version('css/owl.carousel.min.css') }}">
    <link rel="stylesheet" href="/css/magnific-popup.css{{ asset_version('css/magnific-popup.css') }}">
    <link rel="stylesheet" href="/css/font-awesome.min.css{{ asset_version('css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="/css/themify-icons.css{{ asset_version('css/themify-icons.css') }}">
    <link rel="stylesheet" href="/css/nice-select.css{{ asset_version('css/nice-select.css') }}">
    <link rel="stylesheet" href="/css/flaticon.css{{ asset_version('css/flaticon.css') }}">
    <link rel="stylesheet" href="/css/gijgo.css{{ asset_version('css/gijgo.css') }}">
    <link rel="stylesheet" href="/css/animate.css{{ asset_version('css/animate.css') }}">
    <link rel="stylesheet" href="/css/slicknav.css{{ asset_version('css/slicknav.css') }}">
    <link rel="stylesheet" href="/css/style.css{{ asset_version('css/style.css') }}">
    <link rel="stylesheet" href="/css/ers.css{{ asset_version('css/ers.css') }}">
    <link rel="stylesheet" href="/css/responsive.css{{ asset_version('css/responsive.css') }}">
    <link rel="stylesheet" href="/css/modern.css{{ asset_version('css/modern.css') }}">
    {# Tenant/reseller overrides must be last so they can override every base layer. #}
    {% if add_custom_css() %}
        <link rel="stylesheet" href="/css/custom.css{{ asset_version('css/custom.css') }}">
    {% endif %}
    {{ html_fetch('css') }}
{% endblock %}
