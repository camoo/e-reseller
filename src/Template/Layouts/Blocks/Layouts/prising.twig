{% block prising %}
    <!-- prising_area_start -->
    {% if feature_enabled('hosting') %}
    {% set pricingContent = homeContent.pricing|default({}) %}
    <div class="prising_area">
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="section_title text-center mb-100">
                        <h3>{{ t(pricingContent.title|default("Choisissez votre plan d'hébergement")) }}</h3>
                        <p>{{ t(pricingContent.description|default("Notre tableau de contrôle de domaine est conçu pour être facile à utiliser et\npermet de gérer aisément tous les aspects concernant l'administration des noms de domaine."))|nl2br }}</p>
                    </div>
                </div>
            </div>
            <div class="row">
                {{ hosting_plans()|raw }}
            </div>
        </div>
    </div>
    {% endif %}
    <!-- prising_area_end -->
{% endblock %}
