{% block footer %}
    {% set footerContent=showcaseContent.footer|default({}) %}
    <!-- footer -->
    <footer class="footer">
        <div class="camoo-loading invisible"></div>
        <div class="footer_top">
            <div class="container">
                <div class="row">
                    <div class="col-xl-3 col-md-6 col-lg-3">
                        <div class="footer_widget">
                            <div class="footer_logo">
                                <a href="/">
                                    <img src="/img/{{ get_logo_name() }}{{ asset_version('img/' ~ get_logo_name()) }}" alt="{{ siteConfig.company_name|default(siteConfig.title_for_layout) }}">
                                </a>
                            </div>
                            <p class="footer_text doanar"><a class="first" href="tel:{{ siteConfig.company_tel }}">{{ siteConfig.company_tel }}
                                </a> <br>
                                <a href="mailto:{{ siteConfig.contact_email }}">{{ siteConfig.contact_email }}</a></p>
                            <div class="socail_links">
                                <ul>
                                    {% for key,url in siteConfig.social_media %}
                                        <li>
                                            <a rel="nofollow noopener noreferrer" target="_blank" href="{{ url }}">
                                                <i class="fa fa-{{ key }}"></i>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>

                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-lg-3">
                        <div class="footer_widget">
                            <h3 class="footer_title">
                                {{ t(footerContent.services_title|default('service')) }}
                            </h3>
                            <ul>
                                {% if feature_enabled('domains') %}
                                    <li><a href="/">{{ t('Noms de domaine') }}</a></li>
                                {% endif %}
                                {% if feature_enabled('hosting') %}
                                    <li><a href="/packages">{{ t('Hébergement Web') }}</a></li>
                                    <li><a href="/packages#wordpress">{{ t('Wordpress') }}</a></li>
                                {% endif %}
                                {% if feature_enabled('servers') %}
                                    <li><a href="/packages/vps">{{ t('VPS') }}</a></li>
                                {% endif %}
                                {% if feature_enabled('emails') %}
                                    <li><a href="/packages/email">{{ t('Email Professionnel') }}</a></li>
                                {% endif %}
                                {% if feature_enabled('ssl') %}
                                    <li><a href="/packages/ssl">{{ t('Certificats SSL') }}</a></li>
                                {% endif %}
                            </ul>

                        </div>
                    </div>
                    <div class="col-xl-2 col-md-6 col-lg-2">
                        <div class="footer_widget">
                            <h3 class="footer_title">
                                {{ t(footerContent.navigation_title|default('Navigation')) }}
                            </h3>
                            <ul>
                                <li><a href="/">{{ t('Home') }}</a></li>
                                <li><a href="/support">{{ t('Support') }}</a></li>
                                <li><a href="/about-us">{{ t('About') }}</a></li>
                                <li><a href="/contact">{{ t('Contact') }}</a></li>
                                <li><a href="/support/privacy">{{ t('Privacy') }}</a></li>
                                <li><a href="/support/terms">{{ t('Terms') }}</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6 col-lg-4">
                        <div class="footer_widget">
                            <h3 class="footer_title">
                                {{ t(footerContent.newsletter_title|default('Newsletter')) }}
                            </h3>
                            {{ form_start('newsletter', {'url':'/newsletter/subscribe', 'class':'newsletter_form', 'id':'newsletter'}) }}
                                <label>
                                    <input type="email" name="email" autocomplete="email" required placeholder="{{ t(footerContent.newsletter_placeholder|default('Votre E-mail')) }}">
                                </label>
                                <label class="newsletter_honeypot" aria-hidden="true">
                                    <span>{{ t('Website') }}</span>
                                    <input type="text" name="website" tabindex="-1" autocomplete="off">
                                </label>
                                <button type="submit">{{ t(footerContent.newsletter_button|default("S'abonner")) }}</button>
                            {{ form_end() }}
                            <div class="newsletter_feedback" id="newsletter-feedback" role="alert" aria-live="polite"></div>
                            <p class="newsletter_text">{{ t(footerContent.newsletter_description|default('Abonnez-vous à notre newsletter pour ne pas rater nos dernières publications')) }}</p>
                        </div>
                    </div>
                </div>
                {% set paymentMethods = footerContent.payment_methods|default([]) %}
                {% if paymentMethods|length > 0 %}
                    <section class="footer_payment-strip" aria-labelledby="footer-payment-title">
                        {% if footerContent.payment_title|default('Modes de paiement acceptés') is not empty %}
                            <div class="footer_payment-copy">
                                <h3 id="footer-payment-title">{{ t(footerContent.payment_title|default('Modes de paiement acceptés')) }}</h3>
                                {% if footerContent.payment_description|default('') is not empty %}
                                    <p>{{ t(footerContent.payment_description) }}</p>
                                {% endif %}
                            </div>
                        {% endif %}
                        <div class="footer_payment-methods">
                            {% for method in paymentMethods %}
                                {% if method.label|default('') is not empty and (method.enabled is not defined or method.enabled) %}
                                    <span class="footer_payment-method footer_payment-method--{{ method.tone|default('default') }}">
                                        {% if method.image|default('') is not empty %}
                                            <img class="footer_payment-logo" src="{{ method.image }}" alt="{{ t(method.label) }}" loading="lazy">
                                        {% elseif method.badge|default('') is not empty %}
                                            <span class="footer_payment-mark" aria-hidden="true">{{ method.badge }}</span>
                                        {% elseif method.icon|default('') is not empty %}
                                            <i class="{{ method.icon }} footer_payment-icon" aria-hidden="true"></i>
                                        {% endif %}
                                        <span>{{ t(method.label) }}</span>
                                    </span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            </div>
        </div>
        <div class="copy-right_text">
            <div class="container">
                <div class="footer_border"></div>
                <div class="row">
                    <div class="col-xl-12">
                        <p class="copy_right text-center">
                        <span>&copy; Copyright {{ "now"|date('Y', "Africa/Douala") }} by {{ siteConfig.company_name|default(siteConfig.title_for_layout) }}.</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- footer -->
    <!-- link that opens popup -->

    {% if is_loggedin() == false %}
        <!-- form itself end-->
        <section id="test-form" class="white-popup-block mfp-hide">
            <div class="popup_box ">
                <div class="popup_inner">
                    <div class="logo text-center">
                        <a href="#">
                            <img src="/img/{{ get_logo_name() }}{{ asset_version('img/' ~ get_logo_name()) }}" alt="{{ siteConfig.company_name }}">
                        </a>
                    </div>
                    <h3>{{ t('Connexion au compte') }}</h3>
                    {% include 'Layouts/Blocks/Layouts/login-form.twig' %}
                    <p class="doen_have_acc">{{ t('Pas encore un compte?') }} <a class="dont-hav-acc" href="#test-form2">{{ t("S'enregistrer") }}</a>
                    </p>
                </div>
            </div>
        </section>
        <!-- form itself end -->
    {% endif %}

    {% if is_loggedin() == false %}
        <!-- form itself end-->
        <section id="test-form2" class="white-popup-block mfp-hide">
            <div class="popup_box ">
                <div class="popup_inner">
                    <h3>{{ t('Enregistrez-vous') }}</h3>
                    {% include 'Layouts/Blocks/Layouts/register-form.twig' %}
                </div>
            </div>
        </section>
        <!-- form itself end -->
    {% endif %}

    {% if is_loggedin() and basket.count() > 0 and siteConfig.can_mobile_money %}
        <section id="momo-form" class="white-popup-block mfp-hide">
            <div class="popup_box ">
                <div class="popup_inner">
                    <div class="logo text-center">
                        <a href="#">
                            <img src="/img/momo.png{{ asset_version('img/momo.png') }}" alt="{{ t('Mobile money payment') }}">
                        </a>
                    </div>
                    <h3>{{ t('Payer par Mobile Money') }}</h3>
                    {{ form_start('momo', {'url':'#', 'class' : 'online-payment'}) }}
                    <div class="row">
                        <div class="col-xl-12 col-md-12">
                            {{ form_input('phoneNumber', {'type': 'number', 'placeholder' : t('Votre numéro de téléphone'), 'required' : 'required'}) }}
                        </div>

                        <div class="col-xl-12">
                            {{ form_input('submit', {'id':'apply-momo','type' : 'submit', 'class' : 'boxed_btn_green', 'value' : t('Payer')}) }}
                        </div>
                    </div>
                    {{ form_end() }}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}
