{% block footer %}
    <!-- footer -->
    <footer class="footer">
        <div class="camoo-loading invisible"></div>
        <div class="footer_top">
            <div class="container">
                <div class="row">
                    <div class="col-xl-3 col-md-6 col-lg-3">
                        <div class="footer_widget">
                            <div class="footer_logo">
                                <a href="/">
                                    <img src="/img/{{ get_logo_name() }}{{ asset_version('img/' ~ get_logo_name()) }}" alt="{{ siteConfig.company_name }}">
                                </a>
                            </div>
                            <p class="footer_text doanar"><a class="first" href="tel:{{ siteConfig.company_tel }}">{{ siteConfig.company_tel }}
                                </a> <br>
                                <a href="mailto:{{ siteConfig.contact_email }}">{{ siteConfig.contact_email }}</a></p>
                            <div class="socail_links">
                                <ul>
                                    {% for key,url in siteConfig.social_media %}
                                        <li>
                                            <a rel="nofollow noopener noreferrer" target="_blank" href="{{ url }}">
                                                <i class="fa fa-{{ key }}"></i>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>

                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-lg-3">
                        <div class="footer_widget">
                            <h3 class="footer_title">
                                {{ t('service') }}
                            </h3>
                            <ul>
                                {% if feature_enabled('hosting') %}<li><a href="/packages">{{ t('Hosting') }}</a></li>{% endif %}
                                {% if feature_enabled('domains') %}<li><a href="/">{{ t('Domain') }}</a></li>{% endif %}
                                {% if feature_enabled('hosting') %}
                                    <li><a href="/packages#wordpress">{{ t('Wordpress') }}</a></li>
                                    <li><a href="/packages#shared-hosting">{{ t('Shared Hosting') }}</a></li>
                                {% endif %}
                            </ul>

                        </div>
                    </div>
                    <div class="col-xl-2 col-md-6 col-lg-2">
                        <div class="footer_widget">
                            <h3 class="footer_title">
                                {{ t('Navigation') }}
                            </h3>
                            <ul>
                                <li><a href="/">{{ t('Home') }}</a></li>
                                <li><a href="/support">{{ t('Support') }}</a></li>
                                <li><a href="/aboutUs">{{ t('About') }}</a></li>
                                <li><a href="/contact">{{ t('Contact') }}</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6 col-lg-4">
                        <div class="footer_widget">
                            <h3 class="footer_title">
                                {{ t('Newsletter') }}
                            </h3>
                            <form action="#" class="newsletter_form">
                                <label>
                                    <input type="text" placeholder="{{ t('Votre E-mail') }}">
                                </label>
                                <button type="submit">{{ t("S'abonner") }}</button>
                            </form>
                            <p class="newsletter_text">{{ t('Abonnez-vous à notre newsletter pour ne pas rater nos dernières publications') }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copy-right_text">
            <div class="container">
                <div class="footer_border"></div>
                <div class="row">
                    <div class="col-xl-12">
                        <p class="copy_right text-center">
                        <span>&copy; Copyright {{ "now"|date('Y', "Africa/Douala") }} by {{ siteConfig.company_name }}. <a
                                    </span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- footer -->
    <!-- link that opens popup -->

    {% if is_loggedin() == false %}
        <!-- form itself end-->
        <section id="test-form" class="white-popup-block mfp-hide">
            <div class="popup_box ">
                <div class="popup_inner">
                    <div class="logo text-center">
                        <a href="#">
                            <img src="/img/{{ get_logo_name() }}{{ asset_version('img/' ~ get_logo_name()) }}" alt="{{ siteConfig.company_name }}">
                        </a>
                    </div>
                    <h3>{{ t('Connexion au compte') }}</h3>
                    {{ form_start('login', {'url':'/login', 'class' : 'camoo-form-spining'}) }}
                    <div class="row">
                        <div class="col-xl-12 col-md-12">
                            {{ form_input('username', {'type': 'email', 'placeholder' : t('Votre E-Mail'), 'required' : 'required'}) }}


                        </div>
                        <div class="col-xl-12 col-md-12">
                            {{ form_input('passwd', {'type' : 'password', 'placeholder' : t('Mot de passe'), 'required': 'required'}) }}

                        </div>
                        <div class="col-xl-12">
                            {{ form_input('submit', {'id':'user-login','type' : 'submit', 'class' : 'boxed_btn_green', 'value' : t('Se connecter')}) }}

                        </div>
                    </div>
                    {{ form_end() }}
                    <p class="doen_have_acc">{{ t('Pas encore un compte?') }} <a class="dont-hav-acc" href="#test-form2">{{ t("S'enregistrer") }}</a>
                    </p>
                </div>
            </div>
        </section>
        <!-- form itself end -->
    {% endif %}

    {% if is_loggedin() == false %}
        <!-- form itself end-->
        <section id="test-form2" class="white-popup-block mfp-hide">
            <div class="popup_box ">
                <div class="popup_inner">
                    <h3>{{ t('Enregistrez-vous') }}</h3>
                    {{ form_start('join', {'url':'/join', 'class': 'camoo-form-spining'}) }}
                    <div class="row">
                        <div class="col-md-6 col-sm-6 col-xs-12">
                            <div class="div_form_add">
                                <div class="input text required">
                                    {{ form_input('name', {'placeholder' : t('Votre Nom'), 'required' : 'required'}) }}
                                </div>
                                <div class="input text required">
                                    {{ form_input('firstname', {'placeholder' : t('Votre Prénom'), 'required' : 'required'}) }}
                                </div>
                                <div class="input password required">
                                    {{ form_input('password', {'placeholder' : t('Mot de passe'), 'required' : 'required'}) }}
                                </div>
                                <div class="input password">
                                    {{ form_input('password_confirm', {'type': 'password', 'placeholder' : t('Confirmer votre Mot de passe'), 'required' : 'required'}) }}
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-6 col-xs-12">
                            <div class="div_form_add">
                                <div class="input email required">
                                    {{ form_input('email', {'placeholder' : t('Votre E-mail'), 'required' : 'required'}) }}
                                </div>
                                <div class="input text required">
                                    {{ form_input('city', {'placeholder' : t('Votre ville'), 'required' : 'required'}) }}
                                </div>
                                <div class="input phone required">
                                    {{ form_input('phone', {'type':'number', 'placeholder' : t('Votre téléphone'), 'required' : 'required'}) }}

                                </div>
                                <div class="input text required">
                                    {{ form_input('address', {'placeholder' : t('Votre adresse (Rue/Quartier)'), 'required' : 'required'}) }}

                                </div>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            {{ form_input('submit', {'id': 'user-join', 'type' : 'submit', 'class' : 'boxed_btn_green', 'value' : t('Créer votre compte')}) }}

                        </div>
                    </div>
                    {{ form_end() }}
                </div>
            </div>
        </section>
        <!-- form itself end -->
    {% endif %}

    {% if is_loggedin() and basket.count() > 0 and siteConfig.can_mobile_money %}
        <section id="momo-form" class="white-popup-block mfp-hide">
            <div class="popup_box ">
                <div class="popup_inner">
                    <div class="logo text-center">
                        <a href="#">
                            <img src="/img/momo.png{{ asset_version('img/momo.png') }}" alt="{{ t('Mobile money payment') }}">
                        </a>
                    </div>
                    <h3>{{ t('Payer par Mobile Money') }}</h3>
                    {{ form_start('momo', {'url':'#', 'class' : 'online-payment'}) }}
                    <div class="row">
                        <div class="col-xl-12 col-md-12">
                            {{ form_input('phoneNumber', {'type': 'number', 'placeholder' : t('Votre numéro de téléphone'), 'required' : 'required'}) }}
                        </div>

                        <div class="col-xl-12">
                            {{ form_input('submit', {'id':'apply-momo','type' : 'submit', 'class' : 'boxed_btn_green', 'value' : t('Payer')}) }}
                        </div>
                    </div>
                    {{ form_end() }}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}
