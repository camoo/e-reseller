{% block js %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script><!-- jQuery Library -->
    <script>
        $.ajaxPrefilter(function (options) {
            if (String(options.type || options.method || 'GET').toUpperCase() !== 'POST') {
                return;
            }
            const token = $('input[name="__csrf_Token"]').first().val();
            if (!token) {
                return;
            }

            // jQuery serializes object data before invoking prefilters. Keep
            // the serialized payload intact and append the CSRF field to it.
            if (typeof options.data === 'string') {
                if (!/(^|&)__csrf_Token=/.test(options.data)) {
                    options.data += (options.data ? '&' : '')
                        + '__csrf_Token=' + encodeURIComponent(String(token));
                }
                return;
            }

            // Preserve support for requests using processData: false.
            if (options.data && typeof options.data === 'object') {
                options.data.__csrf_Token = token;
            } else {
                options.data = '__csrf_Token=' + encodeURIComponent(String(token));
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
