{% extends "Layouts/pages.twig" %}
{% block content %}
    {% set domainContent=showcaseContent.pages.domain|default({}) %}
    <div class="core_features0 dm_area">
        <div class="container">
            <div class="border-bottm">
                <div class="row">
                    <div class="col-md-offset-2 col-md-8 col-xs-12 col-sm-10" id="div_domain_result_form">
                        <div id="start-domaincheck-error" class="invisible"></div>
                        <div class="panel panel-default">
                            <div class="panel-heading"><h4>{{ t(domainContent.decision_title|default('Indiquez un nom de domaine pour votre commande')) }}</h4></div>
                            <div class="panel-body" id="form-body-search-input">
                                <div class="col-md-12">
                                    <p class="p_choice">
                                        <input type="hidden" name="chose_domain" value=""><label
                                                for="btn_new_domain"><input type="radio" name="chose_domain" value="0"
                                                                            checked="checked" id="btn_new_domain">{{ t(domainContent.new_domain|default('Je veux un nouveau nom de domaine')) }}</label><label for="btn_already_domain"><input
                                                    type="radio" name="chose_domain" value="1" style="margin-left:20px"
                                                    id="btn_already_domain">{{ t(domainContent.existing_domain|default('J’ai déjà un nom de domaine')) }}</label></p>

                                    {{ form_start('domain-lookup', {'id':'domainwhois', 'class': 'find_dowmain_form', 'style' : 'display:none;'}) }}
                                    {{ form_input('domain', {'placeholder' : t(domainContent.search_placeholder|default('Rechercher votre nom de domaine')), 'required' : 'required'}) }}
                                    {{ form_input('submit', {'type' : 'submit', 'value' : t(showcaseContent.hero.search_button|default('Lancer')), 'id' : 'finddomain'}) }}
                                    {{ form_end() }}

                                </div>
                            </div>
                            <div class="form-group">
                                <div class="input text required"><input type="text" name="rs_domain"
                                                                        aria-invalid="false" aria-required="true"
                                                                        autocapitalize="off" autocorrect="off"
                                                                        class="form-control domain-decision-input"
                                                                        placeholder="{{ domainContent.domain_placeholder|default('Entrer le domaine souhaité') }}"
                                                                        data-currentplaceholder="{{ domainContent.domain_placeholder|default('Entrer le domaine souhaité') }}"
                                                                        id="hosting-domain"
                                                                        data-message-invalid-tld="{{ domainContent.invalid_domain|default('Caractères invalides détectés. Veuillez corriger cette erreur pour continuer') }}"
                                                                        required="required"
                                                                        ></div>
                            </div>


                            <div id="div-submit-button">
                                <button data-active="new" class="btn btn-primary" id="domain-decision" type="submit">
                                    {{ t(domainContent.continue_button|default('Recherchez et ajoutez un domaine')) }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div> <!-- end row -->


            </div>
        </div>
    </div>
{% endblock %}
