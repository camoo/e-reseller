#!/usr/bin/env bash

#set your token salt for the local cache.
# CAMOO.Hosting credentials (keep these only in the untracked config/.env)
CAMOO_HOSTING_EMAIL="__USERNAME__"
CAMOO_HOSTING_PASSWORD="__PASSWORD__"
ACCESS_TOKEN_SALT="__TOKEN_SALT__"

DEV_MODE=false
APP_LOCALE=fr_CM
# Optional JSON override for homepage badges, pricing copy, and feature cards.
# The hosting API value `home_content` accepts the same structure.
HOME_CONTENT_JSON=

# PRODUCTS: set any value to false to hide and disable that offering.
FEATURE_DOMAINS=true
FEATURE_EMAILS=true
FEATURE_SSL=true
FEATURE_HOSTING=true
FEATURE_SERVERS=true
# Development-only deterministic domain rows when the provider is unavailable.
LOCAL_DOMAIN_AVAILABILITY=false
# Optional comma-separated TLDs to mark as taken in the local fixture.
LOCAL_DOMAIN_TAKEN_TLDS=
#DOMAIN_NAME='example.com'

# SMTP
SMTP_HOST="ssl://smtp.gmail.com"
SMTP_PORT=465
SMTP_USERNAME="email@gmail.com"
SMTP_PASSWORD="ToPSecret"
SMTP_SECURITY="tls"

# WEB
# Upload replacement files to web/img/ and set their exact filenames here.
# Missing or invalid files automatically fall back to the defaults.
LOGO_FILE_NAME="logo.png"
FAVICON_FILE_NAME="favicon.ico"
